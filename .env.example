# Grammigo — server-side environment variables. Copy to .env.local (gitignored) for local development.
# NEVER commit real values. NEVER prefix any of these with NEXT_PUBLIC_.
# On Vercel, add them under Project → Settings → Environment Variables (mark the key "Sensitive").

# AI features are OFF unless this is exactly "true".
AI_FEATURES_ENABLED=false

# Your OpenAI key. Read only on the server (src/lib/ai/config.ts).
OPENAI_API_KEY=

# Optional model overrides (cost-conscious defaults shown).
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Required before enabling AI in production: durable rate limiting + budget cap (Upstash Redis REST).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# AI_DAILY_CALL_CAP=300

# Only for knowingly running production without Upstash (NOT recommended: serverless instances do not share memory).
# AI_ALLOW_MEMORY_LIMITER_IN_PRODUCTION=false
