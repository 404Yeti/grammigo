# Grammigo — server-side environment variables. Copy to .env.local (gitignored) for local development.
# NEVER commit real values. NEVER prefix any of these with NEXT_PUBLIC_.
# On Vercel, add them under Project → Settings → Environment Variables (mark the key "Sensitive").

# AI features are OFF unless this is exactly "true".
AI_FEATURES_ENABLED=false

# Your OpenAI key. Read only on the server (src/lib/ai/config.ts).
OPENAI_API_KEY=

# Optional model overrides (cost-conscious defaults shown).
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Local cost visibility (counts only, never content). Prices below are ASSUMPTIONS: check openai.com/pricing.
# AI_USAGE_LOG=true
# OPENAI_PRICE_IN_PER_M=0.15
# OPENAI_PRICE_OUT_PER_M=0.6
# OPENAI_PRICE_TRANSCRIBE_PER_MIN=0.006

# Required before enabling AI in production: durable rate limiting + budget cap (Upstash Redis REST).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (Vercel's Upstash integration injects KV_REST_API_URL / KV_REST_API_TOKEN instead; either naming works.)
# AI_DAILY_CALL_CAP=300

# Only for knowingly running production without Upstash (NOT recommended: serverless instances do not share memory).
# AI_ALLOW_MEMORY_LIMITER_IN_PRODUCTION=false

# ---------------------------------------------------------------------------------------------------------------------------------
# Accounts (v0.4). OFF unless NEXT_PUBLIC_ACCOUNTS is exactly "on". With it off, Grammigo is the anonymous on-device app and every
# account page and endpoint answers 404. With it on, anything missing below makes the account endpoints answer 503 (they never fall
# back to a default). All of these are server-side secrets: NEVER prefix any of them with NEXT_PUBLIC_. The Google client id and
# secret are configured in the Supabase dashboard (Authentication > Providers), not here.
# NEXT_PUBLIC_ACCOUNTS=off
# SUPABASE_URL=
# SUPABASE_ANON_KEY=            # the publishable (anon) key; it can only do what row-level security allows
# SUPABASE_SERVICE_ROLE_KEY=    # bypasses row-level security: server only, never in the browser, never in a log
# INVITE_CODE_PEPPER=           # 32+ random characters; keys the invitation-code HMAC. Changing it invalidates every code.
# AUTH_FLOW_SECRET=             # 32+ random characters, DIFFERENT from the pepper; signs the sign-in cookie and keys rate limits
# AUTH_SITE_URL=                # this deployment's exact origin, e.g. https://grammigo.vercel.app (https required except localhost)
# CRON_SECRET=                  # 32+ random characters; the scheduled cleanup route requires "Authorization: Bearer <this>"
